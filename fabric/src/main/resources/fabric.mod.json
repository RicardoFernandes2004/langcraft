{
	"schemaVersion": 1,
	"id": "langcraft",
	"version": "${version}",
	"name": "LangCraft",
	"description": "Practice Korean, Japanese, English, German and Spanish vocabulary with the items in your inventory. Lose a challenge and you pay for it.",
	"authors": ["RicardoFernandes2004"],
	"license": "MIT",
	"icon": "assets/langcraft/icon.png",
	"contact": {
		"sources": "https://github.com/RicardoFernandes2004/linguacraft",
		"issues": "https://github.com/RicardoFernandes2004/linguacraft/issues"
	},
	"environment": "*",
	"entrypoints": {
		"main": ["dev.langcraft.fabric.LangCraftFabric"],
		"client": ["dev.langcraft.fabric.LangCraftFabricClient"],
		"modmenu": ["dev.langcraft.fabric.ModMenuIntegration"]
	},
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
